  "retainedOwners": {
    "duplicate-native-readers": {
      "responsibility": "Construct the admitted fingerprint reader and metadata-only source-state probe",
      "reason": "The factories select native implementations behind Ame ports; availability and analysis policy stay in application owners.",
      "lifetime": "One stateless probe per inspection; fingerprint leases retain the existing shared background admission and held source until publication.",
      "replacement": "Replace these two factories through ExactContentReader and SourceStateProbe while retaining lease and source-safety contracts.",
      "decision": "docs/architecture/workflow-ownership/native-composition.md#duplicate-and-organization-composition",
      "coverage": [
        "rust/src/application/exact_duplicates/availability/tests.rs",
        "rust/src/application/exact_duplicates/execution/tests.rs",
        "rust/src/application/background_analysis/exact_reader/tests.rs"
      ]
    },
    "organization-catalog-composition": {
      "responsibility": "Open lane-scoped catalog handles for duplicate review and virtual organization",
      "reason": "These named factories select storage and the existing validated catalog session; callers use repository ports and adapters retain transactions.",
      "lifetime": "The caller owns each handle; duplicate member reads release it before source inspection, and organization operations retain their transaction boundaries.",
      "replacement": "Replace catalog-session construction together with the repository implementations without changing validation or operation policy.",
      "decision": "docs/architecture/workflow-ownership/native-composition.md#duplicate-and-organization-composition",
      "coverage": [
        "rust/src/adapters/sqlite_catalog/exact_duplicates/tests/review.rs",
        "rust/src/adapters/sqlite_catalog/organization/tests.rs"
      ]
    },
    "organization-batch-composition": {
      "responsibility": "Acquire a bounded organization-selection session and its repository",
      "reason": "The constructor acquires a permit and shared cancellation control, then selects the batch adapter; later operations consume OrganizationBatchRepository.",
      "lifetime": "ActiveSelection owns the repository and capacity permit; failed construction drops the permit, and close signals cancellation before joined retirement.",
      "replacement": "Substitute the batch repository at this constructor while preserving permit, cancellation and close ownership.",
      "decision": "docs/architecture/workflow-ownership/native-composition.md#duplicate-and-organization-composition",
      "coverage": [
        "rust/src/application/organization_batch/tests.rs",
        "rust/src/adapters/sqlite_catalog/organization/tests/batch.rs"
      ]
    }
  },

+use anyhow::{bail, Context, Result};
+use std::{io, path::Path};
+
+pub(super) fn replace_current_directory(
+    current: &Path,
+    staged: &Path,
+    backup: &Path,
+    mut rename: impl FnMut(&Path, &Path, i32) -> io::Result<()>,
+    mut remove_backup: impl FnMut(&Path),
+) -> Result<()> {
+    rename(current, backup, 10)
+        .context("Unable to start the update; the running application directory was retained.")?;
+    if let Err(apply_error) = rename(staged, current, 30) {
+        if let Err(restore_error) = rename(backup, current, 30) {
+            bail!(
+                "Unable to apply the update ({apply_error}) or restore the previous version ({restore_error}). The previous application is retained at {backup:?}."
+            );
+        }
+        return Err(apply_error)
+            .context("Unable to apply the update; the previous application was restored.");
+    }
+    remove_backup(backup);
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::fs;
+
+    struct Fixture {
+        _root: tempfile::TempDir,
+        current: std::path::PathBuf,
+        staged: std::path::PathBuf,
+        backup: std::path::PathBuf,
+    }
+
+    impl Fixture {
+        fn new() -> Self {
+            let root = tempfile::tempdir().unwrap();
+            let current = root.path().join("current");
+            let staged = root.path().join("new");
+            let backup = root.path().join("old");
+            fs::create_dir(&current).unwrap();
+            fs::create_dir(&staged).unwrap();
+            fs::write(current.join("app.exe"), b"retained version").unwrap();
+            fs::write(staged.join("app.exe"), b"new version").unwrap();
+            Self {
+                _root: root,
+                current,
+                staged,
+                backup,
+            }
+        }
+    }
+
+    #[test]
+    fn failed_new_rename_restores_the_previous_application() {
+        let fixture = Fixture::new();
+        let result = replace_current_directory(
+            &fixture.current,
+            &fixture.staged,
+            &fixture.backup,
+            |from, to, _| {
+                if from == fixture.staged {
+                    Err(io::Error::new(
+                        io::ErrorKind::PermissionDenied,
+                        "blocked new rename",
+                    ))
+                } else {
+                    fs::rename(from, to)
+                }
+            },
+            |_| panic!("Failed replacement must not dispose of its backup"),
+        );
+        assert!(result.is_err());
+        assert_eq!(
+            fs::read(fixture.current.join("app.exe")).unwrap(),
+            b"retained version"
+        );
+        assert!(!fixture.backup.exists());
+    }
+
+    #[test]
+    fn successful_replacement_retires_only_the_previous_payload() {
+        let fixture = Fixture::new();
+        replace_current_directory(
+            &fixture.current,
+            &fixture.staged,
+            &fixture.backup,
+            |from, to, _| fs::rename(from, to),
+            |backup| fs::remove_dir_all(backup).unwrap(),
+        )
+        .unwrap();
+        assert_eq!(
+            fs::read(fixture.current.join("app.exe")).unwrap(),
+            b"new version"
+        );
+        assert!(!fixture.backup.exists());
+        assert!(!fixture.staged.exists());
+    }
+
+    #[test]
+    fn failed_restore_preserves_the_complete_backup() {
+        let fixture = Fixture::new();
+        let result = replace_current_directory(
+            &fixture.current,
+            &fixture.staged,
+            &fixture.backup,
+            |from, to, _| {
+                if from == fixture.current {
+                    fs::rename(from, to)
+                } else {
+                    Err(io::Error::new(
+                        io::ErrorKind::PermissionDenied,
+                        "blocked replacement and restore",
+                    ))
+                }
+            },
+            |_| panic!("Failed restore must not delete the retained version"),
+        );
+        let detail = result.unwrap_err().to_string();
+        assert!(detail.contains("retained at"));
+        assert_eq!(
+            fs::read(fixture.backup.join("app.exe")).unwrap(),
+            b"retained version"
+        );
+        assert!(!fixture.current.exists());
+        assert_eq!(
+            fs::read(fixture.staged.join("app.exe")).unwrap(),
+            b"new version"
+        );
+    }
+}

<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI Id="AmeInstallerUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="MS Shell Dlg" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="MS Shell Dlg" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="MS Shell Dlg" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="ARPNOMODIFY" Value="1" />
      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="AmeInstallOptionsDlg" />
      <DialogRef Id="AmeRemoveOptionsDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="CheckTargetPath" Value="[_BrowseProperty]" Order="1" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="SetTargetPath" Value="[_BrowseProperty]" Order="2" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="EndDialog" Value="Return" Order="3" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="AmeInstallOptionsDlg" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="MaintenanceTypeDlg" Condition="Installed AND WixUI_InstallMode &lt;&gt; &quot;Remove&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="AmeRemoveOptionsDlg" Condition="WixUI_InstallMode = &quot;Remove&quot;" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="AmeRemoveOptionsDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
      <ProgressText Action="AmeStartInstalledService" Message="!(loc.AmeStartingService)" />
      <ProgressText Action="AmeRemoveUserData" Message="!(loc.AmeRemovingUserData)" />
      <Error Id="25001" Message="!(loc.AmeInstallationFailed)" />
      <Error Id="25002" Message="!(loc.AmeDataRemovalBlocked)" />
      <Error Id="25003" Message="!(loc.AmeDataRemovalIncomplete)" />
      <InstallUISequence>
        <Custom Action="AmeLocalizeInstaller" Sequence="1" />
      </InstallUISequence>
    </UI>
    <UIRef Id="WixUI_Common" />
    <UIRef Id="WixUI_ErrorProgressText" />
  </Fragment>
</Wix>

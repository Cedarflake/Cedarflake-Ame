<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <SetProperty Id="AmeStartMenuChoice" Value="1" Before="SetAmeDesktopChoice" Sequence="ui"
                 Condition="&amp;AmeStartMenuFeature = 3" />
    <SetProperty Id="AmeDesktopChoice" Value="1" Before="AmeInstallOptionsDlg" Sequence="ui"
                 Condition="&amp;AmeDesktopFeature = 3" />
    <SetProperty Id="WixUI_InstallMode" Value="Remove" Before="AmeRemoveOptionsDlg" Sequence="ui"
                 Condition="Installed AND REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <UI>
      <Dialog Id="AmeRemoveOptionsDlg" Width="370" Height="270" Title="!(loc.AmeRemoveTitle)">
        <Control Id="RemoveData" Type="CheckBox" X="20" Y="102" Width="330" Height="20"
                 Property="AME_REMOVE_USER_DATA" CheckBoxValue="1" Text="!(loc.AmeRemoveDataChoice)" />
        <Control Id="Back" Type="PushButton" X="128" Y="243" Width="70" Height="17"
                 Text="!(loc.AmeBack)" DisableCondition="REMOVE = &quot;ALL&quot;">
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="204" Y="243" Width="74" Height="17"
                 Default="yes" Text="!(loc.AmeNext)">
          <Publish Property="AmeRemoveOptionsShown" Value="1" Order="1" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="284" Y="243" Width="76" Height="17"
                 Cancel="yes" Text="!(loc.AmeCancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Title" Type="Text" X="20" Y="18" Width="330" Height="25"
                 NoPrefix="yes" Text="{\WixUI_Font_Bigger}!(loc.AmeRemoveTitle)" />
        <Control Id="Description" Type="Text" X="20" Y="50" Width="330" Height="34"
                 NoPrefix="yes" Text="!(loc.AmeRemoveDescription)" />
        <Control Id="DataScope" Type="Text" X="35" Y="132" Width="315" Height="88"
                 NoPrefix="yes" Text="!(loc.AmeRemoveDataScope)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>
      <Dialog Id="AmeInstallOptionsDlg" Width="370" Height="270" Title="!(loc.AmeInstallTitle)">
        <Control Id="InstallPath" Type="PathEdit" X="20" Y="105" Width="266" Height="18"
                 Property="AMEAPPDIR" />
        <Control Id="Browse" Type="PushButton" X="294" Y="105" Width="56" Height="18"
                 Text="!(loc.AmeBrowse)">
          <Publish Property="_BrowseProperty" Value="AMEAPPDIR" Order="1" />
          <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2" />
        </Control>
        <Control Id="StartMenu" Type="CheckBox" X="20" Y="152" Width="330" Height="20"
                 Property="AmeStartMenuChoice" CheckBoxValue="1" Text="!(loc.AmeStartMenuChoice)" />
        <Control Id="Desktop" Type="CheckBox" X="20" Y="180" Width="330" Height="20"
                 Property="AmeDesktopChoice" CheckBoxValue="1" Text="!(loc.AmeDesktopChoice)" />
        <Control Id="Next" Type="PushButton" X="204" Y="243" Width="74" Height="17"
                 Default="yes" Text="!(loc.AmeNext)">
          <Publish Event="CheckTargetPath" Value="AMEAPPDIR" Order="1" />
          <Publish Event="SetTargetPath" Value="AMEAPPDIR" Order="2" />
          <Publish Event="AddLocal" Value="AmeStartMenuFeature" Order="3"
                   Condition="AmeStartMenuChoice = &quot;1&quot;" />
          <Publish Event="Remove" Value="AmeStartMenuFeature" Order="4"
                   Condition="AmeStartMenuChoice &lt;&gt; &quot;1&quot;" />
          <Publish Event="AddLocal" Value="AmeDesktopFeature" Order="5"
                   Condition="AmeDesktopChoice = &quot;1&quot;" />
          <Publish Event="Remove" Value="AmeDesktopFeature" Order="6"
                   Condition="AmeDesktopChoice &lt;&gt; &quot;1&quot;" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="7" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="284" Y="243" Width="76" Height="17"
                 Cancel="yes" Text="!(loc.AmeCancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Title" Type="Text" X="20" Y="18" Width="330" Height="25"
                 NoPrefix="yes" Text="{\WixUI_Font_Bigger}!(loc.AmeInstallTitle)" />
        <Control Id="Description" Type="Text" X="20" Y="50" Width="330" Height="20"
                 NoPrefix="yes" Text="!(loc.AmeInstallDescription)" />
        <Control Id="PathLabel" Type="Text" X="20" Y="83" Width="330" Height="17"
                 NoPrefix="yes" Text="!(loc.AmeInstallPathLabel)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>
      <InstallUISequence>
        <Show Dialog="AmeInstallOptionsDlg" Before="ProgressDlg" Condition="NOT Installed" />
        <Show Dialog="AmeRemoveOptionsDlg" After="AmeInstallOptionsDlg"
              Condition="Installed AND REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT AmeRemoveOptionsShown" />
      </InstallUISequence>
    </UI>
  </Fragment>
</Wix>

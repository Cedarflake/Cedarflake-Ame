  <String Id="AmeRollbackRequirement" Value="Enable Windows Installer rollback before installing Ame." />
  <String Id="AmeRollbackDisabledError" Value="Windows Installer rollback is disabled. Ame cannot be upgraded safely." />
  <String Id="AmeCoreFeatureTitle" Value="Ame and file reading helper" />

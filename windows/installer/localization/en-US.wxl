  <String Id="AmeDesktopFeatureDescription" Value="Adds Ame to the desktop." />
  <String Id="AmeInstallTitle" Value="Install Ame" />
  <String Id="AmeInstallDescription" Value="Choose an installation folder and shortcuts." />
  <String Id="AmeInstallPathLabel" Value="Installation folder" />

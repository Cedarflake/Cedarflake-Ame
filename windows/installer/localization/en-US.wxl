  <String Id="AmeRemoveDataChoice" Value="&amp;Delete Ame data" />
  <String Id="AmeRemoveDataScope"
          Value="Deletes library records, settings, caches and downloaded models in this account's default location. Custom locations outside it and original photos are kept. MSI, portable and Microsoft Store editions share this data." />

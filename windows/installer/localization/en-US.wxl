  <String Id="AmeDataRemovalBlocked"
          Value="Ame data could not be deleted. Uninstall has not started. Close Ame and try again, or clear “Delete Ame data”. Technical details: [2]" />
  <String Id="AmeDataRemovalIncomplete"
          Value="Ame was uninstalled, but some Ame data could not be deleted. Your original photos are unchanged. Technical details: [2]" />
